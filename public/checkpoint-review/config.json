        "flaw": "none",
        "practice": true
      },
      "response": [
        {
          "id": "decision",
          "type": "radio",
          "location": "sidebar",
          "prompt": "Your decision as approving officer:",
          "options": [
            {
              "label": "Approve",
              "value": "approve"
            },
            {
              "label": "Return for more information",
              "value": "return"
            },
            {
              "label": "Reject",
              "value": "reject"
            }
          ]
        },
        {
          "id": "concern",
          "type": "radio",
          "location": "sidebar",
          "prompt": "What is your main concern with this nomination?",
          "options": [
            {
              "label": "None, the nomination looks sound",
              "value": "none"
            },
            {
              "label": "Outdated or superseded evidence",
              "value": "stale"
            },
            {
              "label": "A target criterion is not met",
              "value": "criterion"
            },
            {
              "label": "Sources conflict",
              "value": "conflict"
            },
            {
              "label": "Expected harm is too high for the advantage",
              "value": "harm"
            }
          ],
          "withOther": true
        },
        {
          "id": "confidence",
          "type": "likert",
          "location": "sidebar",
          "prompt": "How confident are you in your decision?",
          "numItems": 5,
          "leftLabel": "Not confident",
          "rightLabel": "Very confident"
        },
        {
          "id": "rationale",
          "type": "longText",
          "location": "sidebar",
          "prompt": "Optional: one sentence explaining your decision.",
          "placeholder": "e.g., The key report is out of date.",
          "required": false
        }
      ]
