          },
          {
            "id": "R-102",
            "source": "Signals",
            "summary": "Pattern matches nominated activity",
            "age": "1 hr 10 min",
            "status": "ok",
            "statusText": "Current"
          },
          {
            "id": "R-103",
            "source": "Ground report",
            "summary": "Site in use this morning",
            "age": "2 hr",
            "status": "ok",
            "statusText": "Current"
